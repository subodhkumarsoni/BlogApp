<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title>Create New Blog - Blogify</title>
</head>

<body>
    <%- include('./partials/nav') %>

    <main class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <div class="mb-4 pb-3 border-bottom">
                        <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-2">Editor Studio</span>
                        <h2 class="fw-bold mb-1">Create a New Story</h2>
                        <p class="text-muted small mb-0">Share your knowledge, architecture insights, and tutorials with developers worldwide.</p>
                    </div>

                    <% if (locals.error) { %>
                        <div class="alert alert-danger rounded-3 mb-4" role="alert">
                            <i class="bi bi-exclamation-circle-fill me-2"></i><%= locals.error %>
                        </div>
                    <% } %>

                    <form action="/blog/add-new" method="post" enctype="multipart/form-data">
                        <!-- Cover Image -->
                        <div class="mb-4">
                            <label for="coverImage" class="form-label fw-semibold text-dark">
                                <i class="bi bi-image text-primary me-1"></i> Cover Image
                            </label>
                            <input type="file" 
                                   class="form-control form-control-custom" 
                                   id="coverImage" 
                                   name="coverImage"
                                   accept="image/*">
                            <div class="form-text text-muted small">
                                Upload a high-resolution JPG or PNG (up to 5MB) to represent your article.
                            </div>
                        </div>

                        <!-- Title -->
                        <div class="mb-4">
                            <label for="title" class="form-label fw-semibold text-dark">
                                <i class="bi bi-fonts text-primary me-1"></i> Story Title
                            </label>
                            <input type="text" 
                                   class="form-control form-control-custom fs-5 fw-bold" 
                                   id="title" 
                                   name="title" 
                                   placeholder="e.g. Modern Frontend Architecture with Microfrontends" 
                                   required>
                        </div>

                        <!-- Body -->
                        <div class="mb-4">
                            <label for="body" class="form-label fw-semibold text-dark">
                                <i class="bi bi-text-paragraph text-primary me-1"></i> Content
                            </label>
                            <textarea class="form-control form-control-custom" 
                                      id="body" 
                                      name="body" 
                                      rows="12"
                                      placeholder="Write your article here in detail. Explain the concepts, architecture, pros, cons, and recommendations..." 
                                      required></textarea>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                            <a href="/" class="btn btn-light rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn-primary-gradient px-4 py-2 fs-6">
                                <i class="bi bi-send-fill"></i> Publish Story
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include('./partials/footer') %>
    <%- include('./partials/script') %>
</body>

</html>
