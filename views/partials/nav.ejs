<nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top py-3">
  <div class="container">
    <a class="navbar-brand-custom" href="/">
      <i class="bi bi-feather fs-3"></i>
      <span>Blogify</span>
    </a>
    
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarMain">
      <ul class="navbar-nav me-auto ms-lg-4 mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link-custom" href="/">
            <i class="bi bi-house-door me-1"></i> Home
          </a>
        </li>
      </ul>
      
      <div class="d-flex align-items-center gap-3">
        <% if (locals.user) { %>
          <a href="/blog/add-new" class="btn-primary-gradient py-2 px-3 fs-6">
            <i class="bi bi-pencil-square"></i>
            <span>Write</span>
          </a>

          <div class="dropdown">
            <a class="d-flex align-items-center text-white text-decoration-none dropdown-toggle gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <img src="<%= locals.user.profileImageURL || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(locals.user.fullName || 'User') + '&background=4f46e5&color=fff&bold=true') %>" 
                   alt="<%= locals.user.fullName %>" 
                   class="nav-avatar">
              <span class="fw-semibold d-none d-md-inline text-light"><%= locals.user.fullName %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2">
              <li class="px-3 py-2 text-muted border-bottom mb-1" style="font-size: 0.85rem;">
                Signed in as <br><strong class="text-dark"><%= locals.user.fullName %></strong>
              </li>
              <li>
                <a class="dropdown-item py-2" href="/user/profile">
                  <i class="bi bi-person-circle me-2 text-primary"></i> My Profile
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2" href="/blog/add-new">
                  <i class="bi bi-plus-square me-2 text-success"></i> Add New Blog
                </a>
              </li>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <a class="dropdown-item py-2 text-danger" href="/user/logout">
                  <i class="bi bi-box-arrow-right me-2"></i> Log Out
                </a>
              </li>
            </ul>
          </div>
        <% } else { %>
          <a class="nav-link-custom" href="/user/signin">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
          </a>
          <a class="btn-primary-gradient py-2 px-3" href="/user/signup">
            Get Started
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<% if (locals.error) { %>
  <div class="container mt-3">
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
      <i class="bi bi-exclamation-triangle-fill fs-5"></i>
      <div><%= locals.error %></div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% } %>
