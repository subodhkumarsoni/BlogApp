<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title><%= blog.title %> - Blogify</title>
</head>

<body>
    <%- include('./partials/nav') %>

    <main class="container my-4">
        <div class="article-container">
            <!-- Back Link -->
            <a href="/" class="btn btn-sm btn-outline-secondary rounded-pill mb-4 px-3 d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Stories</span>
            </a>

            <!-- Article Header -->
            <header class="article-header text-start">
                <h1 class="article-title"><%= blog.title %></h1>

                <!-- Author Profile Card -->
                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-4 border">
                    <img src="<%= blog.createdBy?.profileImageURL || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(blog.createdBy?.fullName || 'Author') + '&background=4f46e5&color=fff&bold=true') %>" 
                         width="52" 
                         height="52"
                         class="rounded-circle shadow-sm" 
                         style="object-fit: cover; border: 2px solid #4f46e5;"
                         alt="<%= blog.createdBy?.fullName || 'Author' %>"
                         onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Author&background=4f46e5&color=fff&bold=true';">
                    
                    <div class="flex-grow-1">
                        <div class="fw-bold text-dark fs-6">
                            <%= blog.createdBy?.fullName || 'Anonymous Author' %>
                        </div>
                        <div class="text-muted small d-flex flex-wrap align-items-center gap-2">
                            <span><i class="bi bi-calendar3 me-1"></i><%= new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                            <span>&bull;</span>
                            <span><i class="bi bi-book me-1"></i><%= Math.max(1, Math.ceil((blog.body || '').split(/\s+/).length / 200)) %> min read</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Featured Cover Image -->
            <% if (blog.coverImageURL) { %>
                <div class="text-center">
                    <img src="<%= blog.coverImageURL %>" 
                         alt="<%= blog.title %>"
                         class="article-cover-img"
                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1200&q=80';">
                </div>
            <% } %>

            <!-- Article Body Content -->
            <div class="article-body">
                <%= blog.body %>
            </div>

            <!-- Comments Section -->
            <section class="comments-container">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h3 class="fw-bold fs-4 mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-chat-dots-fill text-primary"></i>
                        <span>Responses</span>
                    </h3>
                    <span class="badge bg-primary rounded-pill px-3 py-2">
                        <%= comments ? comments.length : 0 %>
                    </span>
                </div>

                <!-- Add Comment Form for Logged In User -->
                <% if (locals.user) { %>
                    <div class="comment-box-card">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <img src="<%= locals.user.profileImageURL || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(locals.user.fullName || 'User') + '&background=4f46e5&color=fff&bold=true') %>" 
                                 width="34" 
                                 height="34" 
                                 class="rounded-circle"
                                 alt="<%= locals.user.fullName %>">
                            <span class="fw-semibold small">Commenting as <strong class="text-primary"><%= locals.user.fullName %></strong></span>
                        </div>
                        <form method="post" action="/blog/comment/<%= blog._id %>">
                            <div class="mb-3">
                                <textarea name="content" 
                                          placeholder="Share your thoughts or feedback on this article..."
                                          class="form-control form-control-custom" 
                                          id="content" 
                                          rows="3" 
                                          required></textarea>
                            </div>
                            <div class="text-end">
                                <button class="btn btn-primary-gradient px-4" type="submit">
                                    <i class="bi bi-send-fill me-1"></i> Add
                                </button>
                            </div>
                        </form>
                    </div>
                <% } else { %>
                    <div class="alert alert-light border rounded-4 p-4 text-center mb-4">
                        <i class="bi bi-lock-fill text-muted fs-3 mb-2 d-block"></i>
                        <h5 class="fw-bold mb-1">Want to join the conversation?</h5>
                        <p class="text-muted small mb-3">Sign in or create a free account to leave your thoughts.</p>
                        <a href="/user/signin" class="btn btn-outline-primary rounded-pill px-4 btn-sm me-2 fw-semibold">Sign In</a>
                        <a href="/user/signup" class="btn-primary-gradient py-1 px-3 btn-sm">Get Started</a>
                    </div>
                <% } %>

                <!-- Comments List -->
                <div class="comments-list mt-3">
                    <% if (locals.comments && comments.length > 0) { %>
                        <% comments.forEach(comment => { %>
                            <div class="comment-bubble">
                                <div class="d-flex align-items-start gap-3">
                                    <img src="<%= comment.createdBy?.profileImageURL || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(comment.createdBy?.fullName || 'User') + '&background=4f46e5&color=fff&bold=true') %>" 
                                         width="42" 
                                         height="42"
                                         class="rounded-circle shadow-sm"
                                         style="object-fit: cover;"
                                         alt="<%= comment.createdBy?.fullName || 'User' %>"
                                         onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=User&background=4f46e5&color=fff&bold=true';">
                                    
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <strong class="text-dark fs-6">
                                                <%= comment.createdBy?.fullName || 'Community Member' %>
                                            </strong>
                                            <span class="text-muted small">
                                                <%= new Date(comment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                            </span>
                                        </div>
                                        <p class="mb-0 text-secondary" style="font-size: 0.95rem; line-height: 1.6;">
                                            <%= comment.content %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-chat-square-dots fs-3 d-block mb-1"></i>
                            <p class="small mb-0">No comments yet. Be the first to share your perspective!</p>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>
    </main>

    <%- include('./partials/footer') %>
    <%- include('./partials/script') %>
</body>

</html>
